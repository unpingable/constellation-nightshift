+#[test]
+fn zz_gate_dump_synthetic_config() {
+    let Some(out) = std::env::var_os("PULSE_GATE_DIR") else {
+        return;
+    };
+    let out = std::path::PathBuf::from(out);
+    let root = TempDir::new().expect("tempdir");
+    let (mut config, _) = fixture(&root);
+    let base = std::path::PathBuf::from("/var/lib/constellation-gate/pulse");
+    config.producer_private_key_path = base.join("producer-key.hex");
+    config.outgoing_directory = base.join("outgoing");
+    config.receipt_directory = base.join("receipts");
+    fs::write(out.join("pulse-config.json"), serde_jcs::to_vec(&config).expect("config")).expect("write");
+    fs::copy(root.path().join("producer-key.hex"), out.join("pulse-producer-key.hex")).expect("key");
+}
