{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nightshift.project-predicate-attention/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "policy_id", "policy_digest", "project", "concern", "question", "declaration_profile", "predicate_profile", "nq_catalog_digest", "nq_profile_digest", "nq_input_schema_digest", "pulse_support_policy_id", "pulse_support_policy_digest", "subject_id", "evaluated_at", "window_start_inclusive", "window_end_inclusive", "required_distinct_occurrences", "qualifying_distinct_occurrences", "qualifying_event_ids", "qualifying_recurrence_ids", "pulse_receipt_digests", "upstream_dispositions", "history_digest", "attention_reason_class", "disposition", "detail", "recurrence_basis", "currentness_basis", "reset_basis", "validated", "not_validated"],
  "properties": {
    "schema": {"const": "nightshift.project-predicate-attention/v1"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "policy_id": {"type": "string"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "project": {"type": "string"},
    "concern": {"type": "string"},
    "question": {"type": "string"},
    "declaration_profile": {"type": "string"},
    "predicate_profile": {"type": "string"},
    "nq_catalog_digest": {"$ref": "#/$defs/digest"},
    "nq_profile_digest": {"$ref": "#/$defs/digest"},
    "nq_input_schema_digest": {"$ref": "#/$defs/digest"},
    "pulse_support_policy_id": {"type": "string"},
    "pulse_support_policy_digest": {"$ref": "#/$defs/digest"},
    "subject_id": {"type": "string"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "window_start_inclusive": {"type": "string", "format": "date-time"},
    "window_end_inclusive": {"type": "string", "format": "date-time"},
    "required_distinct_occurrences": {"type": "integer", "minimum": 1},
    "qualifying_distinct_occurrences": {"type": "integer", "minimum": 0},
    "qualifying_event_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "qualifying_recurrence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "pulse_receipt_digests": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "upstream_dispositions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "history_digest": {"$ref": "#/$defs/digest"},
    "attention_reason_class": {"enum": ["NONE", "PROPOSITION_ATTENTION", "ASSURANCE_ATTENTION"]},
    "disposition": {"enum": ["NO_ATTENTION", "WAITING_FOR_RECURRENCE", "ATTENTION_REQUIRED", "INPUT_NOT_CURRENT"]},
    "detail": {"type": "string"},
    "recurrence_basis": {"type": "string"},
    "currentness_basis": {"type": "string"},
    "reset_basis": {"type": "string"},
    "validated": {"type": "array", "items": {"type": "string"}},
    "not_validated": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
