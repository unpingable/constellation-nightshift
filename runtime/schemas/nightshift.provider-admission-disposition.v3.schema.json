{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nightshift:provider-admission-disposition:v3",
  "title":"Nightshift provider admission disposition V3 qualification execution extension",
  "type":"object","additionalProperties":false,
  "required":["schema","disposition_digest","dispatch_digest","requirement_digest","policy_digest","packet_digest","run_id","work_item_id","work_attempt_id","dispatch_occurrence_id","provider_id","model_id","provider_request_occurrence_id","adapter_process_occurrence_id","app_server_session_identity","thread_id","turn_id","disposition","mechanism_state","received_at","response_created","will_retry","acquisition_complete","provider_retry_after","provider_execution","mapper_snapshot_schema","mapper_snapshot_digest","mapper_snapshot","approval_response_sent","protected_effect_absent","authority_effect"],
  "properties":{
    "schema":{"const":"nightshift.provider-admission-disposition/v3"},"disposition_digest":{"$ref":"#/$defs/digest"},"dispatch_digest":{"$ref":"#/$defs/digest"},"requirement_digest":{"$ref":"#/$defs/digest"},"policy_digest":{"$ref":"#/$defs/digest"},"packet_digest":{"$ref":"#/$defs/digest"},
    "run_id":{"$ref":"#/$defs/id"},"work_item_id":{"$ref":"#/$defs/id"},"work_attempt_id":{"$ref":"#/$defs/id"},"dispatch_occurrence_id":{"$ref":"#/$defs/id"},"provider_id":{"$ref":"#/$defs/id"},"model_id":{"$ref":"#/$defs/id"},"provider_request_occurrence_id":{"$ref":"#/$defs/id"},"adapter_process_occurrence_id":{"$ref":"#/$defs/id"},"app_server_session_identity":{"$ref":"#/$defs/id"},"thread_id":{"$ref":"#/$defs/id"},"turn_id":{"$ref":"#/$defs/id"},
    "disposition":{"enum":["NOT_ADMITTED_PROVIDER_UNAVAILABLE","EXECUTION_ADMITTED"]},"mechanism_state":{"enum":["PARKED_NOT_ADMITTED","PROVIDER_COMPLETED"]},"received_at":{"$ref":"#/$defs/time"},"response_created":{"type":"boolean"},"will_retry":{"const":false},"acquisition_complete":{"const":true},"provider_retry_after":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/time"}]},"provider_execution":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/execution"}]},
    "mapper_snapshot_schema":{"const":"nightshift.holding-deterministic-provider-admission-evidence/v2"},"mapper_snapshot_digest":{"$ref":"#/$defs/digest"},"mapper_snapshot":{"$ref":"#/$defs/snapshot"},"approval_response_sent":{"const":false},"protected_effect_absent":{"const":true},"authority_effect":{"const":"SCHEDULING_MECHANISM_EVIDENCE_ONLY"}
  },
  "allOf":[
    {"if":{"properties":{"disposition":{"const":"NOT_ADMITTED_PROVIDER_UNAVAILABLE"}}},"then":{"properties":{"mechanism_state":{"const":"PARKED_NOT_ADMITTED"},"response_created":{"const":false},"provider_retry_after":{"$ref":"#/$defs/time"},"provider_execution":{"type":"null"}}}},
    {"if":{"properties":{"disposition":{"const":"EXECUTION_ADMITTED"}}},"then":{"properties":{"mechanism_state":{"const":"PROVIDER_COMPLETED"},"response_created":{"const":true},"provider_retry_after":{"type":"null"},"provider_execution":{"$ref":"#/$defs/execution"}}}}
  ],
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"id":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[A-Za-z0-9._:/-]+$"},"time":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|\\.(?:(?!000)[0-9]{3}|[0-9]{3}(?!000)[0-9]{3}|[0-9]{6}(?!000)[0-9]{3})Z)$"},
    "execution":{"type":"object","additionalProperties":false,"required":["provider_id","model_id","app_server_session_identity","thread_id","turn_id","first_response_id"],"properties":{"provider_id":{"$ref":"#/$defs/id"},"model_id":{"$ref":"#/$defs/id"},"app_server_session_identity":{"$ref":"#/$defs/id"},"thread_id":{"$ref":"#/$defs/id"},"turn_id":{"$ref":"#/$defs/id"},"first_response_id":{"$ref":"#/$defs/id"}}},
    "snapshot":{"type":"object","additionalProperties":false,"required":["representation","byte_length","sha256","encoding","bytes_hex"],"properties":{"representation":{"const":"RFC8785_NIGHTSHIFT_QUALIFICATION_FAKE_ADAPTER_EVIDENCE"},"byte_length":{"type":"integer","minimum":1,"maximum":16777216},"sha256":{"$ref":"#/$defs/digest"},"encoding":{"const":"hex"},"bytes_hex":{"type":"string","minLength":2,"maxLength":33554432,"pattern":"^[0-9a-f]+$"}}}
  }
}
