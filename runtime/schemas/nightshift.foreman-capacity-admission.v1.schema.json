{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nightshift.invalid/schemas/nightshift.foreman-capacity-admission.v1.schema.json",
  "title": "Nightshift Foreman Capacity Admission V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "capacity_admission_digest", "packet_digest", "admission_digest", "profile_digest", "capacity_requirement_digest", "run_id", "work_item_id", "adapter_id", "provider_id", "packet_model_class", "profile_model_class", "cost_class", "policy_id", "observation_digest", "policy_digest", "decision_digest", "evaluated_at", "speculative_requested", "authority_effect"],
  "properties": {
    "schema": {"const": "nightshift.foreman-capacity-admission/v1"},
    "capacity_admission_digest": {"$ref": "#/$defs/digest"},
    "packet_digest": {"$ref": "#/$defs/digest"},
    "admission_digest": {"$ref": "#/$defs/digest"},
    "profile_digest": {"$ref": "#/$defs/digest"},
    "capacity_requirement_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"$ref": "#/$defs/id"},
    "work_item_id": {"$ref": "#/$defs/id"},
    "adapter_id": {"$ref": "#/$defs/id"},
    "provider_id": {"$ref": "#/$defs/id"},
    "packet_model_class": {"enum": ["small", "bounded", "medium", "large"]},
    "profile_model_class": {"enum": ["small", "bounded", "medium", "large"]},
    "cost_class": {"enum": ["CHEAP", "EXPENSIVE"]},
    "policy_id": {"$ref": "#/$defs/id"},
    "observation_digest": {"$ref": "#/$defs/digest"},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "decision_digest": {"$ref": "#/$defs/digest"},
    "evaluated_at": {"$ref": "#/$defs/canonical_timestamp"},
    "speculative_requested": {"const": false},
    "authority_effect": {"const": "LOCAL_AGENT_COMPUTE_SCHEDULING_ONLY"}
  },
  "allOf": [
    {"if": {"properties": {"packet_model_class": {"enum": ["small", "bounded"]}}}, "then": {"properties": {"cost_class": {"const": "CHEAP"}}}},
    {"if": {"properties": {"packet_model_class": {"enum": ["medium", "large"]}}}, "then": {"properties": {"cost_class": {"const": "EXPENSIVE"}}}},
    {"if": {"properties": {"packet_model_class": {"const": "small"}}}, "then": {"properties": {"profile_model_class": {"const": "small"}}}},
    {"if": {"properties": {"packet_model_class": {"const": "bounded"}}}, "then": {"properties": {"profile_model_class": {"const": "bounded"}}}},
    {"if": {"properties": {"packet_model_class": {"const": "medium"}}}, "then": {"properties": {"profile_model_class": {"const": "medium"}}}},
    {"if": {"properties": {"packet_model_class": {"const": "large"}}}, "then": {"properties": {"profile_model_class": {"const": "large"}}}}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9A-Fa-f]{64}$"},
    "canonical_timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|\\.(?:(?!000)[0-9]{3}|[0-9]{3}(?!000)[0-9]{3}|[0-9]{6}(?!000)[0-9]{3})Z)$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._:/-]+$"}
  }
}
