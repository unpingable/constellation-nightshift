{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nightshift.project-predicate-attention-policy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "policy_digest", "target", "pulse_verifier_executable_digest", "trigger", "recurrence", "reset"],
  "properties": {
    "schema": {"const": "nightshift.project-predicate-attention-policy/v1"},
    "policy_id": {"type": "string", "minLength": 1},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "concern", "question", "declaration_profile", "predicate_profile", "nq_catalog_digest", "nq_profile_digest", "nq_input_schema_digest", "pulse_support_policy_id", "pulse_support_policy_digest", "subject_id"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "concern": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "declaration_profile": {"type": "string", "minLength": 1},
        "predicate_profile": {"type": "string", "minLength": 1},
        "nq_catalog_digest": {"$ref": "#/$defs/digest"},
        "nq_profile_digest": {"$ref": "#/$defs/digest"},
        "nq_input_schema_digest": {"$ref": "#/$defs/digest"},
        "pulse_support_policy_id": {"type": "string", "minLength": 1},
        "pulse_support_policy_digest": {"$ref": "#/$defs/digest"},
        "subject_id": {"type": "string", "minLength": 1}
      }
    },
    "pulse_verifier_executable_digest": {"$ref": "#/$defs/digest"},
    "trigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "PROPOSITION_ATTENTION"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "dispositions"],
          "properties": {
            "kind": {"const": "ASSURANCE_ATTENTION"},
            "dispositions": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/pulseDisposition"}
            }
          }
        }
      ]
    },
    "recurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_distinct_occurrences", "within_seconds"],
      "properties": {
        "required_distinct_occurrences": {"type": "integer", "minimum": 1},
        "within_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "reset": {"enum": ["HORIZON_EXPIRY", "SUPPORTED_CURRENT"]}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pulseDisposition": {
      "enum": ["NQ_RECEIPT_INVALID", "MISSING_SUPPORT", "SUPPORT_PRODUCER_FAILED", "SUPPORT_EVIDENCE_INVALID", "IDENTITY_MISMATCH", "INDEPENDENCE_NOT_QUALIFIED", "PRIMARY_STALE", "SUPPORT_STALE", "SKEW_EXCEEDED", "CONTRADICTORY"]
    }
  }
}
