{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:nightshift:provider-execution-availability-observation:v1",
  "title":"Nightshift provider execution availability observation V1",
  "type":"object","additionalProperties":false,
  "required":["schema","observation_digest","provider_id","model_id","model_class","observed_at","received_at","expires_at","state","source_identity","source_version","provider_retry_after","exact_evidence","authority_effect"],
  "properties":{
    "schema":{"const":"nightshift.provider-execution-availability-observation/v1"},
    "observation_digest":{"$ref":"#/$defs/digest"},"provider_id":{"$ref":"#/$defs/id"},"model_id":{"$ref":"#/$defs/id"},"model_class":{"$ref":"#/$defs/id"},
    "observed_at":{"$ref":"#/$defs/time"},"received_at":{"$ref":"#/$defs/time"},"expires_at":{"$ref":"#/$defs/time"},
    "state":{"enum":["AVAILABLE","MODEL_AT_CAPACITY","PROVIDER_UNAVAILABLE","RATE_LIMITED","AUTHENTICATION_REFUSED","TRANSPORT_ERROR","PROTOCOL_ERROR","UNKNOWN"]},
    "source_identity":{"$ref":"#/$defs/id"},"source_version":{"$ref":"#/$defs/id"},
    "provider_retry_after":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/time"}]},
    "exact_evidence":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/evidence"}]},
    "authority_effect":{"const":"SCHEDULING_MECHANISM_EVIDENCE_ONLY"}
  },
  "$defs":{
    "digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "id":{"type":"string","minLength":1,"maxLength":512,"pattern":"^[A-Za-z0-9._:/-]+$"},
    "time":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|\\.(?:(?!000)[0-9]{3}|[0-9]{3}(?!000)[0-9]{3}|[0-9]{6}(?!000)[0-9]{3})Z)$"},
    "evidence":{"type":"object","additionalProperties":false,"required":["representation","byte_length","sha256","encoding","bytes_hex"],"properties":{"representation":{"enum":["EXACT_PROVIDER_AVAILABILITY_SOURCE_BYTES","EXACT_WIRE_BYTES_INCLUDING_LINE_TERMINATOR","EXACT_ACQUIRED_FRAME_BYTES_INCLUDING_LINE_TERMINATOR"]},"byte_length":{"type":"integer","minimum":1,"maximum":16384},"sha256":{"$ref":"#/$defs/digest"},"encoding":{"const":"hex"},"bytes_hex":{"type":"string","minLength":2,"maxLength":32768,"pattern":"^[0-9a-f]+$"}}}
  }
}
