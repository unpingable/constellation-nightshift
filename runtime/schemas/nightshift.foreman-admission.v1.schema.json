{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nightshift:foreman-admission:v1",
  "title": "Nightshift local foreman admission V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "admission_digest", "run_id", "packet_digest", "operator_basis_digest",
    "admitted_at", "expires_at", "local_runtime_identity", "maximum_concurrent_workers",
    "allowed_adapter_ids", "allowed_provider_model_classes",
    "maximum_new_attempts_per_work_item", "authority_effect", "target_effects_authorized"
  ],
  "properties": {
    "schema": {"const": "nightshift.foreman-admission/v1"},
    "admission_digest": {"$ref": "#/$defs/digest"},
    "run_id": {"$ref": "#/$defs/id"},
    "packet_digest": {"$ref": "#/$defs/digest"},
    "operator_basis_digest": {"$ref": "#/$defs/digest"},
    "admitted_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "local_runtime_identity": {"$ref": "#/$defs/id"},
    "maximum_concurrent_workers": {"type": "integer", "minimum": 1, "maximum": 4},
    "allowed_adapter_ids": {"$ref": "#/$defs/nonempty_unique_ids"},
    "allowed_provider_model_classes": {"$ref": "#/$defs/nonempty_unique_ids"},
    "maximum_new_attempts_per_work_item": {"const": 1},
    "authority_effect": {"const": "LOCAL_AGENT_COMPUTE_SCHEDULING_ONLY"},
    "target_effects_authorized": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-fA-F]{64}$"},
    "id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9._:/-]+$"},
    "nonempty_unique_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  }
}
