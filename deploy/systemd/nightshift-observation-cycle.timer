[Unit]
Description=Nightshift canonical observation-cycle timer

[Timer]
# Default request slots use a UTC five-minute grid. Match the site's epoch
# and cadence with an OnCalendar override when its request policy differs.
# Slot admission and overlap exclusion remain canonical-store decisions.
OnCalendar=*-*-* *:00/5:00 UTC
AccuracySec=5s
RandomizedDelaySec=0
Unit=nightshift-observation-cycle.service
Persistent=true

[Install]
WantedBy=timers.target
