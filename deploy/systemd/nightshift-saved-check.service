[Unit]
Description=Nightshift bounded saved-check tick
After=local-fs.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nightshift/saved-check.env
ExecStart=/usr/local/libexec/nightshift-saved-check-tick --profile ${NIGHTSHIFT_SAVED_CHECK_PROFILE}
User=nightshift
Group=nightshift
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nightshift
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
TimeoutStartSec=300s
