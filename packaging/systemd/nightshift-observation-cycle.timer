[Unit]
Description=Nightshift canonical observation-cycle timer

[Timer]
# Boot and prior activation determine wake times. Nightshift's canonical
# store excludes duplicate claims of the same slot.
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
Unit=nightshift-observation-cycle.service
Persistent=true

[Install]
WantedBy=timers.target
