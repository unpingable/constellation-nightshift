[Unit]
Description=Nightshift canonical observation-cycle timer

[Timer]
# Preserve the existing invocation cadence, boot delay, jitter, and catch-up
# policy. Slot identity and overlap exclusion are enforced by Nightshift's
# canonical transactional store; diagnostic generation is irrelevant.
OnBootSec=2min
OnUnitActiveSec=5min
RandomizedDelaySec=30s
Unit=nightshift-observation-cycle.service
Persistent=true

[Install]
WantedBy=timers.target
